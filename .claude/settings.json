{
  "permissions": {
    "allow": [
      "Artifact",
      "Bash(sed *)", "Bash(sed:*)",
      "Bash(grep *)", "Bash(grep:*)",
      "Bash(head *)", "Bash(head:*)",
      "Bash(tail *)", "Bash(tail:*)",
      "Bash(cat *)", "Bash(cat:*)",
      "Bash(awk *)", "Bash(awk:*)",
      "Bash(cut *)", "Bash(cut:*)",
      "Bash(wc *)", "Bash(wc:*)",
      "Bash(sort *)", "Bash(sort:*)",
      "Bash(uniq *)", "Bash(uniq:*)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Artifact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/artifact-allow.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/artifact-allow.sh\"" }
        ]
      }
    ]
  }
}
